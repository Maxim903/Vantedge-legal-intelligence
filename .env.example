# Google Cloud Console > IAM et administration > Paramètres du projet.
GCP_PROJECT_ID=
# Région BigQuery configurée pour le projet ou le dataset.
BQ_LOCATION=
# Dataset BigQuery pour le web (marts par défaut).
# BQ_DATASET=marts
# Nom du bucket créé dans Google Cloud Console > Cloud Storage.
GCS_BUCKET_RAW=

# Identifiants API depuis le tableau de bord DataForSEO.
DATAFORSEO_LOGIN=
# Mot de passe API depuis le tableau de bord DataForSEO.
DATAFORSEO_PASSWORD=
# Clé API depuis le tableau de bord du fournisseur LLM retenu.
LLM_API_KEY=

# URI de connexion fournie par Neo4j Aura ou par l'instance Neo4j.
NEO4J_URI=
# Utilisateur défini lors de la création de la base Neo4j.
NEO4J_USER=
# Mot de passe défini ou réinitialisé dans Neo4j Aura/Neo4j.
NEO4J_PASSWORD=

# URL du projet dans Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
# Clé anon/publishable publique dans Supabase > Project Settings > API.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service_role/secret dans Supabase > Project Settings > API (serveur uniquement).
SUPABASE_SERVICE_ROLE_KEY=

# Clé secrète API dans Stripe Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
# Secret de signature dans Stripe Dashboard > Developers > Webhooks > endpoint.
STRIPE_WEBHOOK_SECRET=
# Identifiant de prix (price_...) du plan « pro » dans Stripe Dashboard > Product catalog.
STRIPE_PRICE_PRO=
# URL publique de l'application (sans chemin), utilisée pour les URLs de retour Stripe.
APP_URL=http://localhost:3000
